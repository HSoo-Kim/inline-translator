<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9.5pt</ApplicationDefaultFont>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.1.4</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/InlineTranslator/*.cs" Exclude="../../src/InlineTranslator/Program.cs" />
    <EmbeddedResource Include="../../src/InlineTranslator/Assets/app.ico" LogicalName="InlineTranslator.AppIcon" />
  </ItemGroup>
</Project>
